# Lara — voz +34 951 870 058 (Zadarma) · WhatsApp +34 614 037 189 (Evolution)
# Proyecto independiente de Leo (672). Copia a .env en el servidor.

PORT=3002
BOT_NAME=Manuel
EMAIL_FROM_NAME=Lara - Inmobiliaria Bazán
OPS_ALERT_PREFIX=Lara

# Leads a comerciales: email + WhatsApp (instancia Evolution del 614)
AGENT_NOTIFY_CHANNEL=both

# WhatsApp Evolution (móvil +34 614 037 189; distinto de Leo 672 y de la voz 951)
WHATSAPP_PROVIDER=evolution
EVOLUTION_BASE_URL=https://tu-evolution-api.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=bazan-951
WHATSAPP_OWN_NUMBER=34614037189

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ADMIN_API_KEY=
DATABASE_PATH=./data/manuel.db
# Catálogo compartido con Leo (solo lectura en VPS):
# PROPERTIES_DATABASE_PATH=/opt/whatsapp-chatbot/data/chatbot.db
SCRAPE_ENABLED=0
SCRAPE_TARGET_URL=https://www.idealista.com/pro/mambo-inmobiliaria
SCRAPE_KNOWLEDGE_URL=https://www.mamboinmobiliaria.com

# 1 = Lara atiende 24/7 (0 = pausa WhatsApp/emails L-V 10:00-19:30 Europe/Madrid)
BYPASS_WORK_SCHEDULE=1

# 0 = solo contesta a quien escriba primero por WhatsApp (sin outreach a desconocidos)
# 1 = permite WhatsApp proactivo (portales, llamadas perdidas, ficha tras voz)
WHATSAPP_PROACTIVE_OUTREACH=0

# 1 = si el cliente manda nota de voz, responde solo con nota de voz (TTS; texto solo si falla)
WHATSAPP_VOICE_REPLY=1

# Anti-bucle: off | rate (defecto: solo cadencia extrema) | full (añade repetición)
WHATSAPP_BOT_LOOP_GUARD=rate
# Números que el anti-bucle nunca puede silenciar (E.164 sin +, separados por comas)
WHATSAPP_NEVER_MUTE_PHONES=34646424563
# openai (defecto) | azure | auto (auto = Azure si hay AZURE_SPEECH_KEY)
TTS_PROVIDER=openai
WHATSAPP_TTS_VOICE=onyx
# Azure Speech (opcional; español de España). Solo si TTS_PROVIDER=azure|auto
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=es-ES-AlvaroNeural

# --- Email ---
# EMAIL_ENABLED=0 → no lee IMAP (portales). La lógica queda lista para activarla después.
# SMTP sí hace falta para avisos a comerciales y confirmaciones de voz.
EMAIL_ENABLED=0
IMAP_HOST=mail.inmobiliariabazan.com
IMAP_PORT=993
SMTP_HOST=mail.inmobiliariabazan.com
SMTP_PORT=465
EMAIL_USER=manuel@inmobiliariabazan.com
EMAIL_PASS=

VOICE_AGENT_EMAIL_BY_PHONE=34620555989:miguel@inmobiliariabazan.com,34646424563:alvaro@inmobiliariabazan.com,34692682946:david@inmobiliariabazan.com,34663057430:jose@inmobiliariabazan.com
VOICE_BUYER_AGENT_EMAIL=miguel@inmobiliariabazan.com
VOICE_OWNER_AGENT_EMAIL=alvaro@inmobiliariabazan.com

# --- Voz Zadarma +34 951 870 058 ---
ZADARMA_ENABLED=1
ZADARMA_API_SECRET=
ZADARMA_TRACKED_NUMBERS=34951870058
VOICE_API_KEY=

VOICE_LARA_ENABLED=1
VOICE_LARA_ALWAYS_ON=1
# Alias legacy (mismas claves):
VOICE_MANUEL_ENABLED=1
VOICE_MANUEL_ALWAYS_ON=1
VOICE_BUYER_AGENT_NAME=Miguel
VOICE_BUYER_AGENT_PHONE=34620555989
VOICE_OWNER_AGENT_NAME=Álvaro
VOICE_OWNER_AGENT_PHONE=34646424563
# Administración: persona de contacto cuando el cliente quiere hablar con un humano
VOICE_ADMIN_NAME=Ángela
VOICE_ADMIN_PHONE=34672594724
VOICE_ADMIN_EMAIL=admin@inmobiliariabazan.com
VOICE_RECORDINGS_DIR=./data/voice-recordings
VOICE_RETENTION_DAYS=90
# La grabación en sí se activa en voice-agent/.env (VOICE_RECORDING_ENABLED=1)
# y requiere el contenedor egress de LiveKit levantado.

# Panel web (/panel): usuarios propios con contraseña, no la ADMIN_API_KEY.
PANEL_ENABLED=1
PANEL_SESSION_HOURS=12
# Solo se usan la primera vez, cuando aún no hay ningún usuario creado:
PANEL_ADMIN_USER=
PANEL_ADMIN_PASSWORD=
# 1 cuando el panel esté publicado con HTTPS (cookie solo por conexión cifrada)
PANEL_SECURE_COOKIE=0
PANEL_HEALTH_STATUS_FILE=/var/lib/manuel-health/last.status

# Retell AI (recomendado)
RETELL_ENABLED=1
VOICE_LEAD_EMAIL_ENABLED=1
# Tras derivar en llamada: WhatsApp al móvil del cliente con el comercial (independiente de PROACTIVE)
VOICE_CLIENT_WHATSAPP_CONFIRM=1
# Transcripción completa de cada llamada (ops)
VOICE_TRANSCRIPT_EMAIL_ENABLED=1
VOICE_TRANSCRIPT_EMAIL=alvaro@inmobiliariabazan.com

# Meta / portales — desactivados de momento (misma lógica que Leo si EMAIL_ENABLED=1)
# META_FB_ENABLED=0
# META_IG_ENABLED=0
# IDEALISTA_ENABLED=0
# FOTOCASA_ENABLED=0
