# Worker del agente de voz Lara (LiveKit + OpenAI Realtime)

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=lara

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# Realtime: alloy|ash|ballad|coral|echo|sage|shimmer|verse|marin|cedar (NO "nova")
# cedar = voz masculina; marin = femenina (articulación castellano también buena).
OPENAI_REALTIME_VOICE=cedar
# Velocidad: 1.1 un poco más vivo (producto); 1.0 más articulado.
OPENAI_REALTIME_SPEED=1.05
# Turnos teléfono: server_vad (menos cortes por eco) | semantic_vad
OPENAI_REALTIME_TURN_MODE=server_vad
# 0 = sin barge-in (Manuel no cede; menos cortes por eco PSTN). 1 = el cliente puede interrumpir.
OPENAI_REALTIME_INTERRUPT=0
OPENAI_REALTIME_VAD_THRESHOLD=0.88
OPENAI_REALTIME_VAD_SILENCE_MS=780
OPENAI_REALTIME_VAD_PREFIX_MS=300
# Solo si TURN_MODE=semantic_vad: low|medium|high
OPENAI_REALTIME_EAGERNESS=low
# far_field recomendado en teléfono; near_field si hay mucho eco raro
OPENAI_REALTIME_NOISE_REDUCTION=far_field
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe

VPS_BASE_URL=http://127.0.0.1:3002
VOICE_API_KEY=

ZADARMA_DID=34951870058
VOICE_MAX_CALL_MINUTES=15
# Grabación de audio desactivada: basta la transcripción por email
VOICE_RECORDING_ENABLED=0
VOICE_RECORDINGS_DIR=/opt/whatsapp-chatbot-951/data/voice-recordings
VOICE_EGRESS_OUTPUT_DIR=/out
# Saludo: Manuel habla siempre primero. Si hay anuncio de portal, espera silencio (máx. 4s).
VOICE_WELCOME_QUIET_S=0
VOICE_WELCOME_SILENCE_S=0.55
VOICE_WELCOME_MAX_WAIT_S=4.0
